# PDF origin: install only when the new release is ready.
# The current ECS Origin CA certificate covers *.ljhboard.cn (verified 2026-10-27).
# Keep Cloudflare proxy enabled when using this Origin CA certificate.
server {
    listen 80;
    listen [::]:80;
    server_name pdf.ljhboard.cn;
    return 301 https://pdf.ljhboard.cn$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pdf.ljhboard.cn;
    ssl_certificate /www/server/panel/vhost/cert/ai.ljhboard.cn/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/ai.ljhboard.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:18085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
    }
}
