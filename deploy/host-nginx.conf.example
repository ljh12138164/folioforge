# Install only after provisioning this domain's TLS certificate.
# If using the existing Cloudflare for SaaS origin, use its validated origin
# certificate and hostname configuration instead of copying an unrelated cert.
server {
    listen 80;
    listen [::]:80;
    server_name folioforge.ljhboard.cn;
    return 301 https://folioforge.ljhboard.cn$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name folioforge.ljhboard.cn;
    ssl_certificate /etc/letsencrypt/live/folioforge.ljhboard.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/folioforge.ljhboard.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:18085;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache off;
    }
}
