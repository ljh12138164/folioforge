#!/bin/sh
set -eu
set -f
# Intentional word splitting; glob expansion is disabled above.
# shellcheck disable=SC2086
set -- ${SSH_ORIGINAL_COMMAND:-}
if [ "$#" -lt 2 ] || [ "$#" -gt 3 ] || [ "$1" != deploy ] || ! printf '%s\n' "$2" | grep -Eq '^sha-[0-9a-f]{40}$' \
    || { [ "$#" -eq 3 ] && [ "$3" != image ]; }; then
    echo "Only 'deploy sha-<40 lowercase hex characters> [image]' is allowed." >&2
    exit 126
fi
shift
exec sudo -n /usr/local/sbin/deploy-folioforge "$@"
