{
  "name": "pixelforge",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "web:test": "turbo run test --filter=@pixelforge/web",
    "test:unit": "pnpm --filter @pixelforge/web test:unit",
    "web:bench": "pnpm --filter @pixelforge/web build && pnpm --filter @pixelforge/web test:bench",
    "desktop:start": "pnpm --filter @pixelforge/web build && pnpm --filter @pixelforge/desktop start",
    "desktop:package": "pnpm --filter @pixelforge/web build && pnpm --filter @pixelforge/desktop package",
    "desktop:test": "turbo run test --filter=@pixelforge/desktop"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
