{
  "name": "pixelforge",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "test": "turbo run test",
    "web:test": "turbo run test --filter=@pixelforge/image-web --filter=@pixelforge/pdf-web",
    "test:unit": "pnpm --filter @pixelforge/image-web --filter @pixelforge/pdf-web test:unit",
    "web:bench": "pnpm --filter @pixelforge/image-web build && pnpm --filter @pixelforge/image-web test:bench",
    "dev:image": "pnpm --filter @pixelforge/image-web dev",
    "dev:pdf": "pnpm --filter @pixelforge/pdf-web dev",
    "build:image": "pnpm --filter @pixelforge/image-web build",
    "build:pdf": "pnpm --filter @pixelforge/pdf-web build",
    "preview:image": "pnpm --filter @pixelforge/image-web preview",
    "preview:pdf": "pnpm --filter @pixelforge/pdf-web preview",
    "check:architecture": "node scripts/check-architecture.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.3"
  }
}
