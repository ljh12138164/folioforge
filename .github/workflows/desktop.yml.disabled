# 暂停：先完成 Web 应用迁移；恢复执行前将扩展名改回 .yml 并复核配置。
name: Desktop compatibility

on:
  push:
    branches: [main]
    tags: ['desktop-v*']
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: desktop-${{ github.head_ref || github.ref }}
  cancel-in-progress: ${{ !startsWith(github.ref, 'refs/tags/desktop-v') }}

jobs:
  desktop:
    strategy:
      fail-fast: false
      matrix:
        os: [windows-2025, macos-15, macos-15-intel, ubuntu-24.04]
    runs-on: ${{ matrix.os }}
    timeout-minutes: 30
    steps:
      - uses: actions/checkout@v6
      - name: Check desktop release version
        if: startsWith(github.ref, 'refs/tags/desktop-v')
        shell: bash
        run: |
          node --input-type=module <<'NODE'
          import assert from 'node:assert/strict';
          import { readFileSync } from 'node:fs';
          const { version } = JSON.parse(readFileSync('apps/desktop/package.json', 'utf8'));
          assert.match(version, /^\d+\.\d+\.\d+(?:-[0-9A-Za-z.-]+)?$/);
          assert.equal(process.env.GITHUB_REF_NAME, `desktop-v${version}`, 'Tag must match apps/desktop/package.json version');
          const pdfVersion = JSON.parse(readFileSync('apps/pdf-desktop/package.json', 'utf8')).version;
          assert.equal(pdfVersion, version, 'Both desktop products must match the release tag');
          NODE
      - uses: actions/setup-node@v6
        with:
          node-version: 24
      - uses: pnpm/action-setup@v4
      - name: Install Rust WASM target
        run: rustup toolchain install 1.97.1 --profile minimal --target wasm32-unknown-unknown
      - uses: actions/cache@v4
        with:
          path: |
            ~/.cargo/registry
            ~/.cargo/git
            ~/.cargo/bin/wasm-bindgen*
            target
          key: rust-heic-${{ runner.os }}-${{ runner.arch }}-${{ hashFiles('Cargo.lock', 'rust-toolchain.toml') }}
      - run: pnpm install --frozen-lockfile
      - name: Install Electron binary before resolving its path
        working-directory: apps/desktop
        run: node -e "require('electron')"
      - run: pnpm --filter @pixelforge/image-web exec playwright install --with-deps chromium
      - if: runner.os == 'Linux'
        name: Install Linux desktop test dependencies
        run: sudo apt-get update && sudo apt-get install -y xvfb libgtk-3-0t64 libnss3 libasound2t64
      - if: runner.os == 'Linux'
        name: Configure Electron sandbox helper
        working-directory: apps/desktop
        run: |
          sandbox="$(node -p "require('node:path').join(require('node:path').dirname(require.resolve('electron')), 'dist', 'chrome-sandbox')")"
          sudo chown root:root "$sandbox"
          sudo chmod 4755 "$sandbox"
      - run: pnpm check
      - run: pnpm --filter @pixelforge/image-engine test
      - run: pnpm --filter @pixelforge/heic-wasm test
      - run: pnpm --filter @pixelforge/vectorizer-wasm test
      - name: Cache verified OCR models
        uses: actions/cache@v4
        continue-on-error: true
        with:
          path: apps/pdf-web/public/pdf-assets/ocr/v7/lang
          key: ocr-models-${{ hashFiles('apps/pdf-web/scripts/prepare-ocr-assets.mjs') }}
      - run: pnpm build
      - name: Test Web renderer
        run: pnpm --filter @pixelforge/image-web --filter @pixelforge/pdf-web test
      - name: Test desktop application
        shell: bash
        run: |
          if [ "$RUNNER_OS" = Linux ]; then
            xvfb-run -a pnpm --filter @pixelforge/desktop test
            xvfb-run -a pnpm --filter @pixelforge/pdf-desktop test
          else
            pnpm --filter @pixelforge/desktop test
            pnpm --filter @pixelforge/pdf-desktop test
          fi
      - run: pnpm --filter @pixelforge/desktop --filter @pixelforge/pdf-desktop package
      - if: runner.os == 'Linux'
        name: Configure packaged sandbox helper
        run: |
          sudo chown root:root apps/desktop/dist/PixelForge-linux-x64/chrome-sandbox
          sudo chmod 4755 apps/desktop/dist/PixelForge-linux-x64/chrome-sandbox
          sudo chown root:root apps/pdf-desktop/dist/FolioForge-linux-x64/chrome-sandbox
          sudo chmod 4755 apps/pdf-desktop/dist/FolioForge-linux-x64/chrome-sandbox
      - name: Test packaged application
        shell: bash
        run: |
          if [ "$RUNNER_OS" = Linux ]; then
            xvfb-run -a pnpm --filter @pixelforge/desktop test:package
            xvfb-run -a pnpm --filter @pixelforge/pdf-desktop test:package
          else
            pnpm --filter @pixelforge/desktop test:package
            pnpm --filter @pixelforge/pdf-desktop test:package
          fi
      - name: Archive verified desktop package
        if: startsWith(github.ref, 'refs/tags/desktop-v')
        shell: bash
        run: |
          version=$(node -p "require('./apps/desktop/package.json').version")
          platform=$(node -p 'process.platform')
          arch=$(node -p 'process.arch')
          package="PixelForge-$platform-$arch"
          mkdir -p release
          case "$platform" in
            win32)
              export RELEASE_ARCHIVE="release/PixelForge-$version-$platform-$arch.zip"
              # PowerShell, rather than Bash, expands its environment variable.
              # shellcheck disable=SC2016
              powershell.exe -NoProfile -Command 'Compress-Archive -LiteralPath apps/desktop/dist/PixelForge-win32-x64 -DestinationPath $env:RELEASE_ARCHIVE'
              ;;
            darwin)
              ditto -c -k --sequesterRsrc --keepParent "apps/desktop/dist/$package" "release/PixelForge-$version-$platform-$arch.zip"
              ;;
            linux)
              tar -czf "release/PixelForge-$version-$platform-$arch.tar.gz" -C apps/desktop/dist "$package"
              ;;
          esac
          case "$platform" in
            win32)
              export RELEASE_ARCHIVE="release/FolioForge-$version-$platform-$arch.zip"
              # shellcheck disable=SC2016
              powershell.exe -NoProfile -Command 'Compress-Archive -LiteralPath apps/pdf-desktop/dist/FolioForge-win32-x64 -DestinationPath $env:RELEASE_ARCHIVE'
              ;;
            darwin) ditto -c -k --sequesterRsrc --keepParent "apps/pdf-desktop/dist/FolioForge-$platform-$arch" "release/FolioForge-$version-$platform-$arch.zip" ;;
            linux) tar -czf "release/FolioForge-$version-$platform-$arch.tar.gz" -C apps/pdf-desktop/dist "FolioForge-$platform-$arch" ;;
          esac
      - uses: actions/upload-artifact@v4
        if: startsWith(github.ref, 'refs/tags/desktop-v')
        with:
          name: desktop-release-${{ matrix.os }}
          path: release/*
          if-no-files-found: error
          retention-days: 7
      - uses: actions/upload-artifact@v4
        if: always()
        continue-on-error: true # Evidence upload must not replace the test verdict when account storage is full.
        with:
          name: desktop-evidence-${{ matrix.os }}
          retention-days: 3
          path: |
            apps/desktop/work/smoke/*.png
            apps/desktop/work/packaged-smoke/*.png
            apps/pdf-web/work/test-results/**
            apps/image-web/work/test-results/**
            apps/pdf-desktop/work/smoke/*.png
            apps/pdf-desktop/work/packaged-smoke/*.png

  release:
    if: startsWith(github.ref, 'refs/tags/desktop-v')
    needs: desktop
    runs-on: ubuntu-24.04
    permissions:
      contents: write
    steps:
      - uses: actions/download-artifact@v4
        with:
          pattern: desktop-release-*
          merge-multiple: true
          path: release
      - name: Verify release assets and create draft
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          GH_REPO: ${{ github.repository }}
        run: |
          version="${GITHUB_REF_NAME#desktop-v}"
          cd release
          assets=(
            "FolioForge-$version-win32-x64.zip"
            "FolioForge-$version-darwin-arm64.zip"
            "FolioForge-$version-darwin-x64.zip"
            "FolioForge-$version-linux-x64.tar.gz"
            "PixelForge-$version-win32-x64.zip"
            "PixelForge-$version-darwin-arm64.zip"
            "PixelForge-$version-darwin-x64.zip"
            "PixelForge-$version-linux-x64.tar.gz"
          )
          for asset in "${assets[@]}"; do test -s "$asset"; done
          sha256sum "${assets[@]}" > SHA256SUMS.txt
          flags=()
          if [[ "$version" == *-* ]]; then flags+=(--prerelease); fi
          gh release create "$GITHUB_REF_NAME" "${assets[@]}" SHA256SUMS.txt \
            --verify-tag --draft --generate-notes --title "FolioForge $version" \
            --notes '桌面便携包，解压后保留整个目录。当前未签名、公证，无安装向导或自动更新。Linux 沙箱配置及各平台运行方法见仓库 docs/DESKTOP-RELEASE.md。' \
            "${flags[@]}"
