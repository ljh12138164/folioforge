# Public configuration, embedded at build time. Rebuild after changing these.
NEXT_PUBLIC_SITE_URL=https://img.ljhboard.cn
# Set false for a public staging build. Its sitemap will be empty.
NEXT_PUBLIC_SITE_INDEXABLE=true
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.ljhboard.cn/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=69bf35a5-ccf1-4dca-b709-d128d73aa44f
# Set NEXT_PUBLIC_UMAMI_WEBSITE_ID to an empty value to disable analytics.
