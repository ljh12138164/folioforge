{
  "name": "@pixelforge/image-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @pixelforge/heic-wasm --filter @pixelforge/vectorizer-wasm build && node scripts/prepare-image-assets.mjs && next dev --webpack --hostname 127.0.0.1 --port 43187",
    "build": "pnpm --filter @pixelforge/heic-wasm --filter @pixelforge/vectorizer-wasm build && node scripts/prepare-image-assets.mjs && next build --webpack",
    "check": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:bench": "playwright test --config bench.config.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@pixelforge/heic-wasm": "workspace:*",
    "@pixelforge/image-engine": "workspace:*",
    "@pixelforge/vectorizer-wasm": "workspace:*",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@pixelforge/ui": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "vitest": "^5.0.5"
  }
}
