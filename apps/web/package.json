{
  "name": "@pixelforge/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-pdf-assets.mjs && next dev --webpack --hostname 127.0.0.1 --port 43187",
    "build": "node scripts/prepare-pdf-assets.mjs && next build --webpack && node scripts/build-pdf-offline.mjs",
    "check": "tsc --noEmit",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:bench": "playwright test --config bench.config.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@pixelforge/image-engine": "workspace:*",
    "fflate": "^0.8.2",
    "lucide-react": "^0.468.0",
    "next": "^16.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.2.0",
    "vitest": "^5.0.5"
  }
}
